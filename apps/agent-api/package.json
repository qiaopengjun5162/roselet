{
  "name": "@roselet/agent-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "mcp": "tsx src/mcp.ts",
    "pay": "tsx src/client.ts",
    "wasm": "cd ../../crates/recommend && wasm-pack build --target nodejs --out-dir ../../apps/agent-api/pkg && rm -f ../../apps/agent-api/pkg/.gitignore",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.9",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "@solana/kit": "^5.5.1",
    "@solana/sysvars": "^5.5.1",
    "@x402/core": "2.19.0",
    "@x402/fetch": "2.19.0",
    "@x402/hono": "2.19.0",
    "@x402/mcp": "2.19.0",
    "@x402/svm": "2.19.0",
    "goatflow-sdk-server": "0.3.0",
    "hono": "^4.12.27",
    "undici": "^7.16.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.19.15",
    "@vitest/coverage-v8": "^3.2.4",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
