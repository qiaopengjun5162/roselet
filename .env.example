# Roselet 环境变量配置示例
# 复制此文件为 .env 并填写实际值

# 数据库配置（必需）
DATABASE_URL=postgres://localhost/roselet

# 后端服务端口（可选，默认 3001）
PORT=3001

# JWT 密钥（生产环境必需，≥32 字节）
# 生成方法：openssl rand -base64 48
JWT_SECRET=your-secret-key-at-least-32-bytes-long

# OpenAI API 配置（可选，用于 AI 回复功能）
OPENAI_API_KEY=sk-your-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# 生产环境 CORS（逗号分隔）
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# 前端配置（Next.js）
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=ws://localhost:3001

# Base Sepolia 链上纪念版（可选；前后端合约地址必须一致）
# 服务端用 RPC 校验交易回执，不保存或使用任何用户钱包私钥
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
ROSE_MEMORIAL_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
NEXT_PUBLIC_ROSE_MEMORIAL_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# Aleo testnet 私密 Vault（部署后填写实际 program id 和执行费）
NEXT_PUBLIC_ALEO_VAULT_PROGRAM_ID=roselet_private_vault.aleo
NEXT_PUBLIC_ALEO_EXECUTION_FEE_MICROCREDITS=100000

# Solana 会员模式 · 上链核验（前后端必须指向同一集群）
# 后端用 SOLANA_RPC_URL 通过 getTransaction 核验交易真实存在、签名/付款钱包匹配、
# 且确实调用了 Memo 程序。生产环境必须配置，否则会跳过核验（可存入伪造引用）。
SOLANA_RPC_URL=https://api.devnet.solana.com
# 前端广播交易用的 RPC；留空则回退到 clusterApiUrl("devnet")
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
# 优先费（micro-lamports / CU，可选；不填 = 不加 ComputeBudget 指令）
# Devnet 无需设置。主网拥堵时必须设，否则 Memo 交易可能长时间排队不落地。
# 代价 ≈ 该值 × 20000 CU ÷ 1e6 lamports（例：50000 → 1000 lamports ≈ 0.000001 SOL）
NEXT_PUBLIC_SOLANA_PRIORITY_FEE_MICROLAMPORTS=

# 会员模式 · 铸造 Token-2022 NFT
# 玫瑰没有上传图片时，NFT 的 uri 指向前端站点上的玫瑰页；改域名时设置这一项，
# 否则链上会写入 https://roselet-web.vercel.app/rose/<id>
NEXT_PUBLIC_SITE_URL=https://roselet-web.vercel.app

# 会员模式 · 图片上传到 IPFS（可选）
# PINATA_JWT 只留在后端，禁止加 NEXT_PUBLIC_ 前缀或下发到浏览器
# 不配置时 /api/ipfs/upload 返回 503，前端仍可手动填写已有 CID
PINATA_JWT=your-pinata-jwt
# Pinata v3 上传端点；改回经典 pinFileToIPFS 端点也可，后端兼容两种响应格式
PINATA_UPLOAD_URL=https://uploads.pinata.cloud/v3/files

# Solana Devnet x402 Agent API
X402_SVM_PAY_TO=YOUR_SOLANA_DEVNET_ADDRESS
X402_FACILITATOR_URL=https://x402.org/facilitator
X402_REFLECTION_PRICE=$0.001
X402_SOLANA_RPC_URL=https://api.devnet.solana.com
AGENT_API_HOST=127.0.0.1
AGENT_API_PORT=4021
